   "source": [
    "n = 5\n",
    "size = 2 * n - 1\n",
    "\n",
    "for i in range(size):\n",
    "\n",
    "    for j in range(size):\n",
    "\n",
    "        print(n - min(i, j, size - 1 - i, size - 1 - j), end=\" \")\n",
    "\n",
    "    print()"
