   "metadata": {},
   "source": [
    "##### 8. Prime Number Spiral Matrix"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "0ff5641f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2 3 5 7 11\n",
      "53 59 61 67 13\n",
      "47 89 97 71 17\n",
      "43 83 79 73 19\n",
      "41 37 31 29 23\n"
     ]
    }
   ],
   "source": [
    "# i didn't do it myself \n",
    "\n",
    "n = 5\n",
    "\n",
    "# ---------- generate primes ----------\n",
    "primes = []\n",
    "num = 2\n",
    "\n",
    "while len(primes) < n * n:\n",
    "\n",
    "    prime = True\n",
    "\n",
    "    for i in range(2, int(num**0.5) + 1):\n",
    "        if num % i == 0:\n",
    "            prime = False\n",
    "            break\n",
    "\n",
    "    if prime:\n",
    "        primes.append(num)\n",
    "\n",
    "    num += 1\n",
    "\n",
    "# ---------- empty matrix ----------\n",
    "arr = [[0] * n for _ in range(n)]\n",
    "\n",
    "# directions: right, down, left, up\n",
    "dr = [0, 1, 0, -1]\n",
    "dc = [1, 0, -1, 0]\n",
    "\n",
    "r = 0\n",
    "c = 0\n",
    "d = 0\n",
    "\n",
    "for val in primes:\n",
    "\n",
    "    arr[r][c] = val\n",
    "\n",
    "    nr = r + dr[d]\n",
    "    nc = c + dc[d]\n",
    "\n",
    "    # change direction if blocked\n",
    "    if nr < 0 or nr >= n or nc < 0 or nc >= n or arr[nr][nc] != 0:\n",
    "        d = (d + 1) % 4\n",
    "\n",
    "    r += dr[d]\n",
    "    c += dc[d]\n",
    "\n",
    "# ---------- print ----------\n",
    "for row in arr:\n",
    "    print(*row)"
   ]
  },
